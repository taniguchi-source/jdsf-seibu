<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # jdsf-seibu.com 本体のみに適用（サブドメインには適用しない）
  RewriteCond %{HTTP_HOST} ^(www\.)?jdsf-seibu\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# HTML は常に最新を確認させる（更新後に古いキャッシュが表示されるのを防ぐ。
# ETag により未変更なら 304 が返り通信は軽量。JSON はURLに ?_=時刻 を付けて取得済み）
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
